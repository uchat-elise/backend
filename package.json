{
  "name": "uchat-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "sh scripts/clean-start.sh",
    "start:server": "tsx src/index.ts",
    "start:clean": "sh scripts/clean-start.sh",
    "test": "node scripts/test.cjs",
    "redis:start": "docker compose -f ../docker-compose.redis.yml up -d redis",
    "redis:stop": "docker compose -f ../docker-compose.redis.yml down",
    "redis:logs": "docker compose -f ../docker-compose.redis.yml logs -f redis",
    "start:e2e": "node scripts/start-e2e.cjs",
    "migrate": "node scripts/migrate.js",
    "migrate:apply": "node scripts/apply-migrate.js",
    "schema:apply": "node scripts/apply-schema.js",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.111.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.0",
    "pg": "^8.11.0",
    "resend": "^6.18.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2"
  }
}
